#!/usr/bin/env bash

cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit

echo "Last version: $(cat version)"

read -p "Enter new version: " VERSION

if [ -z "$VERSION" ]; then
    echo "Version is required"
    exit 1
fi

if [ -f "version" ]; then
    CURRENT_VERSION=$(cat version)
    if [ "$VERSION" == "$CURRENT_VERSION" ]; then
        echo "Version $VERSION is already released"
        exit 1
    fi
fi

echo "$VERSION" > version

git add version
git commit -s -m "Release $VERSION" || exit 1
git tag -a -s "$VERSION" -m "$VERSION" || exit 1

# Push the branch first and the tag only after the branch was accepted. A tag that reached the remote cannot be
# removed again where tags are immutable, so a refused branch must leave the tag local. The tag is named explicitly,
# because the option that sends all tags would publish other local tags as well. Both pushes name the same remote,
# so a push remote configured for the branch cannot split the branch and the tag.
if ! git push --no-follow-tags origin; then
    echo "The push of the branch was refused, so the tag $VERSION stays local."
    echo "Land exactly this release commit on the branch, which a fast-forward does and a squash merge does not, and push the tag again."
    exit 1
fi

git push --no-follow-tags origin "refs/tags/$VERSION"
